<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>UnionTech Software Technology Co., Ltd.</vendor>
  <vendor_url>https://www.deepin.org</vendor_url>

  <action id="cn.uniontech.cooperation.forward.setup">
    <description>Set up subnet forwarding rules for Deepin Cooperation</description>
    <description xml:lang="zh_CN">为跨端协同设置子网转发规则</description>
    <message>Deepin Cooperation needs to redirect local subnet traffic through the cooperation session</message>
    <message xml:lang="zh_CN">跨端协同需要将本机发往配置网段的流量经协同会话转发</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="cn.uniontech.cooperation.forward.teardown">
    <description>Remove subnet forwarding rules of Deepin Cooperation</description>
    <description xml:lang="zh_CN">移除跨端协同的子网转发规则</description>
    <message>Deepin Cooperation needs to remove its subnet forwarding rules</message>
    <message xml:lang="zh_CN">跨端协同需要移除其子网转发规则</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

</policyconfig>
